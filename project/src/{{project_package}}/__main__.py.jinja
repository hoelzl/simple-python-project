{% if cli == "typer" -%}
from typing import Annotated

import typer

from . import __version__
from .functions import say_hi


def version_callback(value: bool):
    if value:
        print(f"Awesome CLI Version: {__version__}")
        raise typer.Exit()


def typer_main(
    name: Annotated[
        str, typer.Option(help="The name of the person to greet.")
    ] = "world",
    version: Annotated[
        bool | None,
        typer.Option(help="Show the version and exit.", callback=version_callback),
    ] = None,
):
    say_hi(name)


def main():
    typer.run(typer_main)


if __name__ == "__main__":
    main()
{% elif cli == "click" -%}
import click

from . import __version__
from .functions import say_hi


@click.command()
@click.option("--name", help="The name of the person to greet.", default="world")
@click.version_option(version=__version__)
def main(name):
    say_hi(name)


if __name__ == "__main__":
    main()
{% elif cli == "argparse" -%}
import argparse

from .functions import say_hi


def main():
    parser = argparse.ArgumentParser(
        prog="{{project_package.replace('_', '-')}}",
        description="{{description}}",
        epilog="Have fun!",
    )
    parser.add_argument(
        "-n", "--name", default="world", help="the name of the person to greet"
    )
    args = parser.parse_args()
    say_hi(args.name)


if __name__ == "__main__":
    main()
